# Nerkh API token (Bearer)
# برای توسعه محلی در .dev.vars هم می‌توانید بگذارید.
# در پروداکشن از طریق GitHub Secrets → NERKH_IO_TOKEN ست می‌شود.
NERKH_IO_TOKEN=ENTER_YOUR_NERKH_TOKEN

# Cloudflare API Token – برای دیپلوی لوکال با wrangler و برای GitHub Actions
# Create at https://dash.cloudflare.com/profile/api-tokens
# Permissions: Account.Cloudflare Workers:Edit
CLOUDFLARE_API_TOKEN=ENTER_YOUR_CLOUDFLARE_API_TOKEN

# Cloudflare Account ID (در GitHub Secrets هم لازم است)
# CLOUDFLARE_ACCOUNT_ID=
